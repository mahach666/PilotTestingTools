<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net8.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<AssemblyName>pilottest</AssemblyName>
		<RootNamespace>PilotTestHost.Cli</RootNamespace>
	</PropertyGroup>

	<ItemGroup>
		<!-- Журнал и сохраненный вход клиента - общий исходник с PilotUITesting -->
		<Compile Include="..\Shared\*.cs" Link="Shared\%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<!-- ProtectedDataEx клиента (net48) ссылается на DataProtectionScope; в .NET 8 этот тип есть только в пакете -->
		<PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
	</ItemGroup>

</Project>
